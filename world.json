  "levels": [
    {
      "id": "florist-conditioning-flower-food",
      "index": 1,
      "title": "Brewing the Bloom Tonic",
      "task_id": "conditioning-flower-food",
      "skill_name": "Cut Flower Food Preparation",
      "mechanic": "mix",
      "quest": {
        "npc_id": "flora",
        "location_id": "conditioning-bench",
        "title": "Prepare Fresh Hydration Water"
      },
      "aim": "Mix the solution to reach the ideal nutrient concentration and temperature for vase uptake.",
      "controls_hint": "Up/Down pick a setting, Left/Right adjust it, Enter to Blend. Or drag a slider and click Blend.",
      "metric": {
        "name": "Hydration Balance",
        "description": "0-100 from how close water temperature, preservative concentration are to good practice"
      },
      "time_limit_ms": null,
      "success_line": "Sparkling clear water and happily perked rose petals!",
      "dialogue": [
        {
          "at": "quest",
          "npc_id": "flora",
          "text": "Our morning harvest looks parched from the wagon ride. Could you blend a lukewarm bucket bath with the right amount of flower food so they drink easily?"
        },
        {
          "at": "start",
          "npc_id": "bramble",
          "text": "If the water is too chilly the stems tighten up, but too hot and you will stew them."
        },
        {
          "at": "start",
          "npc_id": "flora",
          "text": "A pinch too little food lets murky bacteria blossom, while the right balance keeps vase water sparkling clean."
        },
        {
          "at": "pass",
          "npc_id": "flora",
          "text": "The solution feels soothingly warm, and the roses will drink deeply without drooping."
        },
        {
          "at": "fail",
          "npc_id": "flora",
          "text": "The bucket looks a bit off. Make sure the water is temperate and has enough flower food to keep bacteria away."
        }
      ],
      "params": {
        "station_id": "conditioning-bench",
        "variables": [
          {
            "id": "water_volume",
            "label": "Water Volume",
            "unit": "ml",
            "min": 500,
            "max": 2500,
            "step": 50,
            "default": 800
          },
          {
            "id": "food_powder",
            "label": "Flower Food Powder",
            "unit": "g",
            "min": 2,
            "max": 35,
            "step": 1,
            "default": 4
          },
          {
            "id": "water_temp",
            "label": "Water Temperature",
            "unit": "°C",
            "min": 10,
            "max": 60,
            "step": 1,
            "default": 16
          }
        ],
        "submit_label": "Blend"
      },
      "scoring": {
        "pass_threshold": 70,
        "variables": {
          "water_temp": {
            "range": [
              38,
              43
            ],
            "tolerance": 5,
            "weight": 1,
            "curve": "gaussian",
            "feedback": {
              "too_low": "The water is too cold; viscous water and trapped air embolisms delay stem rehydration.",
              "too_high": "The water is dangerously hot; tender stem vascular tissues are scalded and collapse."
            }
          }
        },
        "derived": [
          {
            "id": "solution_concentration",
            "label": "Preservative Concentration",
            "expr": "food_powder / (water_volume / 1000)",
            "target": 10,
            "tolerance": 2.5,
            "weight": 1.5,
            "curve": "gaussian",
            "feedback": {
