  "levels": [
    {
      "id": "barista-brew-coffee",
      "index": 1,
      "title": "Brew coffee",
      "task_id": "brew-coffee",
      "skill_name": "Brew coffee",
      "mechanic": "mix",
      "quest": {
        "npc_id": "juniper",
        "location_id": "coffee-bar",
        "title": "Fix the coffee"
      },
      "aim": "Brew a sweet, balanced mug: not sour, bitter or weak.",
      "controls_hint": "Up/Down pick a setting, Left/Right adjust it, Enter to Brew. Or drag a slider and click Brew.",
      "metric": {
        "name": "Taste",
        "description": "0-100 from coffee, water, brew time and their balance"
      },
      "time_limit_ms": null,
      "success_line": "Sweet and smooth, that's our house cup!",
      "dialogue": [
        {
          "at": "quest",
          "npc_id": "juniper",
          "text": "Our coffee tastes funny, can you fix it at the coffee bar?"
        },
        {
          "at": "start",
          "npc_id": "luca",
          "text": "Sour means it ran too fast, bitter means too slow."
        },
        {
          "at": "start",
          "npc_id": "juniper",
          "text": "Weak or strong is all about water versus coffee."
        },
        {
          "at": "pass",
          "npc_id": "juniper",
          "text": "Yum, write that recipe on the board!"
        },
        {
          "at": "fail",
          "npc_id": "juniper",
          "text": "Taste it again, the cup tells you where to go."
        }
      ],
      "params": {
        "station_id": "coffee-bar",
        "variables": [
          {
            "id": "dose_g",
            "label": "Coffee",
            "unit": "g",
            "min": 10,
            "max": 30,
            "step": 0.5,
            "default": 15.5
          },
          {
            "id": "water_ml",
            "label": "Water",
            "unit": "ml",
            "min": 200,
            "max": 450,
            "step": 10,
            "default": 320
          },
          {
            "id": "contact_s",
            "label": "Brew time",
            "unit": "s",
            "min": 60,
            "max": 360,
            "step": 10,
            "default": 150
          }
        ],
        "submit_label": "Brew"
      },
      "scoring": {
        "pass_threshold": 75,
        "variables": {
          "dose_g": {
            "target": 18,
            "tolerance": 1.2,
            "weight": 2,
            "curve": "gaussian",
            "feedback": {
              "too_low": "Thin and sour: the shallow coffee bed let the water rush straight through.",
              "too_high": "Heavy and bitter: the bed is packed too deep and the cup is too strong."
            }
          },
          "water_ml": {
            "target": 300,
            "tolerance": 30,
            "weight": 1,
            "curve": "gaussian",
            "feedback": {
              "too_low": "The mug comes out short: not a full house serving.",
              "too_high": "Brew spills past the mug: more than a house serving."
            }
          },
          "contact_s": {
            "range": [
              180,
              210
            ],
            "tolerance": 30,
            "weight": 2,
            "curve": "gaussian",
            "feedback": {
              "too_low": "Sour and salty: under-extracted, the water left the grounds too soon.",
              "too_high": "Bitter, drying finish: over-extracted, the grounds steeped too long."
            }
          }
        },
        "derived": [
          {
            "id": "brew_ratio",
            "label": "Water per gram",
            "expr": "water_ml / dose_g",
            "range": [
              16,
              18
            ],
            "tolerance": 1.5,
            "weight": 2,
            "curve": "gaussian",
            "feedback": {
              "too_low": "Too strong: intense and heavy, too little water for this much coffee.",
              "too_high": "Too weak: watery and hollow, too much water for the coffee."
            }
          }
        ]
      },
      "sources": [
        {
          "title": "Coava Coffee - V60 brew method (20 g : 320 g, 3:00-3:30)",
          "url": "https://coavacoffee.com/brew-methods/v60"
        },
        {
          "title": "Gusto's Coffee - SCA Golden Cup standards (55 g/L +/-10%, 93 °C +/-3, contact times)",
          "url": "https://www.gustoscoffeeco.com/how-to-make-better-coffee-sca-golden-cup-standards/"
        },
        {
          "title": "Counter Culture Coffee - Coffee Basics: What is TDS?",
          "url": "https://counterculturecoffee.com/blogs/counter-culture-coffee/coffee-basics"
        },
        {
          "title": "SCAE Coffee Basics brochure - the brewing control chart (via Bunn)",
          "url": "https://resource.bunn.com/library/eZine/coffee_basics_brochure_scae_english/files/basic-html/page4.html"
        },
        {
          "title": "Moccamaster - Certified by the SCA: the Golden Cup standard (92-96 °C)",
          "url": "https://us.moccamaster.com/blogs/blog/certified-by-the-sca-moccamaster-and-the-golden-cup-standard"
        },
        {
          "title": "SCA - Fellow Aiden Precision Coffee Maker (programmable brew profiles)",
          "url": "https://new.sca.coffee/entries/fellow-aiden-precision-coffee-maker"
        }
      ]
    },
    {
      "id": "barista-pour-latte-art",
      "index": 2,
      "title": "Pour latte art",
      "task_id": "pour-latte-art",
      "skill_name": "Pour latte art",
      "mechanic": "timing",
      "quest": {
        "npc_id": "luca",
        "location_id": "milk-bar",
        "title": "Learn latte art"
      },
      "aim": "Steam the milk just right, then pour a leaf pattern.",
      "controls_hint": "Heat: hold Up or the mouse, let go to stop. Pour: press Up or Enter to stop the needle.",
      "metric": {
        "name": "Pour",
        "description": "0-100 from milk heat, pour height and when you drop in"
      },
      "time_limit_ms": 50000,
      "success_line": "Pretty leaves, that one goes on our wall!",
      "dialogue": [
        {
          "at": "quest",
          "npc_id": "luca",
          "text": "Come to the milk bar and I'll teach you latte art!"
        },
        {
          "at": "start",
          "npc_id": "juniper",
          "text": "Hot to touch is good, too hot to hold is burnt."
        },
        {
          "at": "start",
          "npc_id": "luca",
          "text": "Pour high first, then drop low and let the white bloom."
        },
        {
          "at": "pass",
          "npc_id": "luca",
          "text": "Look at those leaves, you're a natural!"
        },
        {
          "at": "fail",
          "npc_id": "luca",
          "text": "So close, watch the milk heat and your drop."
        }
      ],
      "params": {
        "station_id": "milk-bar",
        "phases": [
          {
            "id": "milk_temp_c",
            "label": "Heat the milk",
            "unit": "°C",
            "min": 20,
            "max": 80,
            "mode": "hold",
            "fill_per_s": 12
          },
          {
            "id": "pour_height_cm",
            "label": "Pour height",
            "unit": "cm",
            "min": 2,
            "max": 22,
            "mode": "stop",
            "period_ms": 4000
          },
          {
            "id": "design_fill_pct",
            "label": "When to drop in",
            "unit": "% full",
            "min": 30,
            "max": 100,
            "mode": "stop",
            "period_ms": 4000
          }
        ]
      },
      "scoring": {
        "pass_threshold": 70,
        "variables": {
          "milk_temp_c": {
            "range": [
              57,
              65
            ],
            "tolerance": 5,
            "weight": 2,
            "curve": "gaussian",
            "feedback": {
              "too_low": "Lukewarm milk: flat, barely sweet, and the foam never turned glossy.",
              "too_high": "Scalded milk: cooked taste, sweetness gone, foam dry and stiff."
            }
          },
          "pour_height_cm": {
            "range": [
              8,
              10
            ],
            "tolerance": 2,
            "weight": 1.5,
            "curve": "gaussian",
            "feedback": {
              "too_low": "Poured too close too early: white foam spread over the crema, no canvas left.",
              "too_high": "Poured from too high: the stream splashed and broke up the crema."
            }
          },
          "design_fill_pct": {
            "range": [
              45,
              55
            ],
            "tolerance": 8,
            "weight": 1.5,
            "curve": "gaussian",
            "feedback": {
              "too_low": "Dropped in too early: the pattern sank and blurred into a muddy blob.",
              "too_high": "Dropped in too late: no room left, the rosetta came out cramped and tiny."
            }
          }
        }
      },
      "sources": [
        {
          "title": "Verve Coffee - How to steam milk (135-150 F)",
          "url": "https://vervecoffee.com/blogs/the-verve-blog/how-to-steam-milk"
        },
        {
          "title": "Verve Coffee - How to pour rosetta latte art",
          "url": "https://www.vervecoffee.com/blogs/the-verve-blog/how-to-pour-rosetta-latte-art"
        },
        {
          "title": "Complete Home Barista - How to pour a rosetta latte art pattern",
          "url": "https://completehomebarista.com/faqs/milk-latte-art/how-to-make-rosetta-latte-art/"
        },
        {
          "title": "Yanko Design - Artly robots learn latte art from barista demonstrations (CES 2026)",
          "url": "https://www.yankodesign.com/2026/01/07/artly-robots-master-latte-art-and-drinks-for-ces-2026-debut/"
        }
      ]
    },
    {
      "id": "barista-take-order",
      "index": 3,
      "title": "Take an order",
      "task_id": "take-order",
      "skill_name": "Take an order",
      "mechanic": "converse",
      "quest": {
        "npc_id": "maya",
        "location_id": "counter",
        "title": "Serve Maya"
      },
      "aim": "Take the order right and keep the allergy safe.",
      "controls_hint": "Up/Down choose what to say, Enter to answer. Or click an answer.",
      "metric": {
        "name": "Order",
        "description": "0-100 average quality of your replies; an allergy slip ends it"
      },
      "time_limit_ms": null,
      "success_line": "Right order, safe allergy, happy Maya!",
      "dialogue": [
        {
          "at": "quest",
          "npc_id": "maya",
          "text": "Can I order at the counter for me and my kid?"
        },
        {
          "at": "pass",
          "npc_id": "maya",
          "text": "You got every detail, see you tomorrow!"
        },
        {
          "at": "fail",
          "npc_id": "maya",
          "text": "Hmm, I'm not sure that's safe for her."
        }
      ],
      "params": {
        "npc_id": "maya",
        "turns": [
          {
            "id": "greet",
            "npc_line": "A big latte, not normal milk, plus something for my kid?",
            "options": [
              {
                "id": "assume-oat",
                "text": "One large oat latte, coming right up!",
                "reply": "Oh, um, okay then."
              },
              {
                "id": "ask-milk-and-kid",
                "text": "Sure! Which milk: oat, soy or almond? And what for your kid?",
                "reply": "Ooh, let me think!"
              },
              {
                "id": "point-to-screen",
                "text": "You can order on the screen over there.",
                "reply": "But I'm standing right here."
              }
            ]
          },
          {
            "id": "allergy",
            "npc_line": "Almond for me, and hot chocolate for her, she's allergic to nuts.",
            "options": [
              {
                "id": "one-jug",
                "text": "No problem, I'll steam both in one jug to save time.",
                "reply": "Wait, not the same jug!"
              },
              {
                "id": "flag-allergy-clean-jug",
