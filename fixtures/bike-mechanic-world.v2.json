  "levels": [
    {
      "id": "bike-mechanic-chain-hot-wax-blend",
      "index": 1,
      "title": "Silky Chain Wax Blend",
      "task_id": "chain-hot-wax-blend",
      "skill_name": "Drivetrain Wax Formulation",
      "mechanic": "mix",
      "quest": {
        "npc_id": "bram",
        "location_id": "melting-crock",
        "title": "Simmering the Drivetrain Wax"
      },
      "aim": "Mix the optimal proportion of paraffin wax, micronized PTFE powder, and liquid paraffin oil to create a flexible, ultra-low-friction solid chain wax bath that will not flake off or attract road grime.",
      "controls_hint": "Up/Down pick a setting, Left/Right adjust it, Enter to Melt. Or drag a slider and click Melt.",
      "metric": {
        "name": "Lube Quality",
        "description": "0-100 from how close fully refined paraffin wax, sub-micron ptfe powder, liquid paraffin (mineral oil) are to good practice"
      },
      "time_limit_ms": null,
      "success_line": "Gleaming, supple links that hum like silk!",
      "dialogue": [
        {
          "at": "quest",
          "npc_id": "bram",
          "text": "The canal towpath dust has been chewing up drivetrains. Let's simmer a clean wax bath with slick powders so every link glides effortlessly."
        },
        {
          "at": "start",
          "npc_id": "pip",
          "text": "If the chain cools into a stiff candle, you might need a touch more softening oil."
        },
        {
          "at": "start",
          "npc_id": "bram",
          "text": "Make sure the links warm up thoroughly in the pot, or the wax won't soak deep into the rollers."
        },
        {
          "at": "pass",
          "npc_id": "bram",
          "text": "That chain will run whisper-quiet across the cobblestones."
        },
        {
          "at": "fail",
          "npc_id": "bram",
          "text": "A bit too stiff or gritty—let's rebalance the melt before dipping another link."
        }
      ],
      "params": {
        "station_id": "melting-crock",
        "variables": [
          {
            "id": "paraffin_wax",
            "label": "Fully Refined Paraffin Wax",
            "unit": "g",
            "min": 250,
            "max": 750,
            "step": 25,
            "default": 300
          },
          {
            "id": "ptfe_powder",
            "label": "Sub-Micron PTFE Powder",
            "unit": "g",
            "min": 10,
            "max": 90,
            "step": 5,
            "default": 15
          },
          {
            "id": "paraffin_oil",
            "label": "Liquid Paraffin (Mineral Oil)",
            "unit": "ml",
            "min": 5,
            "max": 75,
            "step": 5,
            "default": 60
          }
        ],
        "submit_label": "Melt"
      },
      "scoring": {
        "pass_threshold": 70,
        "variables": {
          "paraffin_wax": {
            "range": [
              475,
              525
            ],
            "tolerance": 50,
            "weight": 1,
            "curve": "gaussian",
            "feedback": {
              "too_low": "The wax bath volume is insufficient to fully submerge the chain links during thermal immersion.",
              "too_high": "Excessive wax mass wastes crockpot heating energy and dilutes thermal transfer to the chain pins."
            }
          },
          "ptfe_powder": {
            "range": [
              45,
              55
            ],
            "tolerance": 10,
            "weight": 1.2,
            "curve": "gaussian",
            "feedback": {
              "too_low": "Boundary lubrication is inadequate; friction testing shows increased metal-on-metal wear under high wattage.",
              "too_high": "Excess modifier agglomerates into sludge at the bottom of the melting vessel and leaves powdery surface buildup."
            }
          },
          "paraffin_oil": {
            "range": [
              20,
              30
            ],
            "tolerance": 8,
            "weight": 1.1,
            "curve": "gaussian",
            "feedback": {
              "too_low": "Wax matrix is too brittle, causing the dried film to shatter and flake off the inner link plates immediately.",
              "too_high": "Wax blend remains soft and tacky, attracting road dust and grit like wet oil."
            }
          }
        },
        "derived": [
          {
            "id": "additive_to_wax_ratio",
            "label": "Additive-to-Wax Mass Ratio",
            "expr": "(ptfe_powder + paraffin_oil) / paraffin_wax",
            "range": [
              0.13,
              0.17
            ],
            "tolerance": 0.03,
            "weight": 1.3,
            "curve": "gaussian",
            "feedback": {
              "too_low": "The additive concentration is too weak relative to the wax carrier, compromising low-friction boundary coating.",
              "too_high": "Additive saturation destabilizes the crystalline paraffin structure, resulting in premature wash-off and chain noise."
            }
          }
        ]
      },
      "sources": [
        {
          "title": "Zero Friction Cycling Lubricant Research",
          "url": "https://zerofrictioncycling.com.au/"
        },
        {
          "title": "Silca Chain Waxing Explained",
          "url": "https://silca.cc/blogs/silca/chain-waxing-explained"
        }
      ]
    },
