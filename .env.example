# Model provider: google | anthropic | openai | bedrock.
# Leave LLM_PROVIDER empty to use the first provider whose key is set (in that order).
LLM_PROVIDER=
# Optional model override. Defaults: gemini-3.8-flash, claude-opus-5-5, gpt-6-luna, openai.gpt-6-luna (Bedrock)
LLM_MODEL=

# Google Gemini
GEMINI_API_KEY=
# Anthropic
ANTHROPIC_API_KEY=
# OpenAI
OPENAI_API_KEY=
# AWS Bedrock API key (OpenAI models through bedrock-mantle)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/openai/v1

# Gradium voice (optional; text controls work without it)
GRADIUM_API_KEY=

# Entire platform configuration (agent-native Git repository & checkpoints)
ENTIRE_REMOTE_URL=entire://aws-eu-central-1.entire.io/et/replaceme/replaceme
ENTIRE_WORKSPACE_ROOT=./
