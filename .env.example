# Google Gemini API configuration for agentic calls (Researcher, Builder, Actor)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Gradium API configuration for real-time voice synthesis and interactive audio prompts
GRADIUM_API_KEY=your_gradium_api_key_here

# Entire platform configuration (agent-native Git repository & checkpoints)
ENTIRE_REMOTE_URL=entire://aws-eu-central-1.entire.io/et/replaceme/replaceme
ENTIRE_WORKSPACE_ROOT=./
