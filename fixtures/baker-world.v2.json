  "levels": [
    {
      "id": "baker-country-loaf-mix",
      "index": 1,
      "title": "Rustic Country Dough",
      "task_id": "country-loaf-mix",
      "skill_name": "Dough Hydration and Scaling",
      "mechanic": "mix",
      "quest": {
        "npc_id": "bram",
        "location_id": "kneading-bench",
        "title": "Mix the Sourdough Batch"
      },
      "aim": "Balance dough hydration and salinity to achieve an open, aerated crumb structure without slack spreading.",
      "controls_hint": "Up/Down pick a setting, Left/Right adjust it, Enter to Mix. Or drag a slider and click Mix.",
      "metric": {
        "name": "Crumb Texture",
        "description": "0-100 from how close strong bread flour, fine sea salt, hydration ratio are to good practice"
      },
      "time_limit_ms": null,
      "success_line": "Silky, stretchy, and alive—pure bakery magic!",
      "dialogue": [
        {
          "at": "quest",
          "npc_id": "bram",
          "text": "Morning, apprentice! Let's get our hands floury and mix up a fresh tub of country sourdough."
        },
        {
          "at": "start",
          "npc_id": "mina",
          "text": "If your dough sticks like glue to the scraper, she's craving a touch more flour."
        },
        {
          "at": "start",
          "npc_id": "bram",
          "text": "Salt wakes up the starter, but too little leaves the dough lazy and slack."
        },
        {
          "at": "pass",
          "npc_id": "bram",
          "text": "That feels supple under the knuckles. Good feel for the dough!"
        },
        {
          "at": "fail",
          "npc_id": "bram",
          "text": "Don't fret, dough is forgiving. Scrape down the tub and let's try again."
        }
      ],
      "params": {
        "station_id": "kneading-bench",
        "variables": [
          {
            "id": "flour_mass",
            "label": "Strong Bread Flour",
            "unit": "g",
            "min": 400,
            "max": 600,
            "step": 10,
            "default": 460
          },
          {
            "id": "water_mass",
            "label": "Filtered Spring Water",
            "unit": "g",
            "min": 250,
            "max": 450,
            "step": 5,
            "default": 290
          },
          {
            "id": "salt_mass",
            "label": "Fine Sea Salt",
            "unit": "g",
            "min": 2,
            "max": 20,
            "step": 0.5,
            "default": 4
          }
        ],
        "submit_label": "Mix"
      },
      "scoring": {
        "pass_threshold": 70,
        "variables": {
          "flour_mass": {
            "range": [
              490,
              510
            ],
            "tolerance": 25,
            "weight": 1,
            "curve": "gaussian",
            "feedback": {
              "too_low": "The batch volume is too meager for the proofing baskets, resulting in a squat loaf.",
              "too_high": "The dough overflows the banneton and spills over the hearth stones."
            }
          },
          "salt_mass": {
            "range": [
              9.5,
              10.5
            ],
            "tolerance": 1.5,
            "weight": 1.5,
            "curve": "gaussian",
            "feedback": {
              "too_low": "The crumb lacks structural resilience and the flavor is flat and bland.",
              "too_high": "The yeast fermentation is stunted, leaving the bread pale, dense, and unpleasantly salty."
            }
          }
        },
        "derived": [
          {
            "id": "hydration_percent",
            "label": "Hydration Ratio",
            "expr": "(water_mass / flour_mass) * 100",
            "range": [
              72,
              76
            ],
            "tolerance": 3,
            "weight": 2,
            "curve": "gaussian",
            "feedback": {
              "too_low": "The dough feels stiff and tight, producing a compact sandwich crumb rather than an open artisan interior.",
